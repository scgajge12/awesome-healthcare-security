#!/usr/bin/env bash
# コミット対象の Markdown にリンク切れがないかを確認する。
# 有効化：git config core.hooksPath .githooks
set -uo pipefail

files=()
while IFS= read -r f; do files+=("$f"); done < <(
  git diff --cached --name-only --diff-filter=ACMR -- '*.md' ':!:docs/reference/_templates/*'
)

[ "${#files[@]}" -eq 0 ] && exit 0

echo "pre-commit: リンクを確認する（${#files[@]} ファイル）"
if ./scripts/link-check.sh "${files[@]}"; then
  exit 0
fi

# 外部サイト側の一時的な応答不良でコミットが止まるのを避けるため、既定では警告に留める。
# 確実に落としたいときは LINK_CHECK_STRICT=1 を付けて実行する。
if [ "${LINK_CHECK_STRICT:-0}" = "1" ]; then
  echo "pre-commit: リンク切れを検出したためコミットを中止する" >&2
  exit 1
fi

echo "pre-commit: リンク切れの可能性を検出した。内容を確認すること（コミットは継続する）" >&2
exit 0
